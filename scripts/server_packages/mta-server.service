[Unit]
Description=MTA Audio Editor Server (native package)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/usr/lib/mta-audio-editor-server
EnvironmentFile=/etc/mta/mta.env
ExecStart=/opt/mta/server-venv/bin/python -m app.ai_cgroup_launcher
Restart=on-failure
RestartSec=5
Delegate=cpu io
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/mta /etc/mta
[Install]
WantedBy=multi-user.target
