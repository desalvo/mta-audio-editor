#!/bin/sh
set -eu
[ "$1" = configure ] || exit 0
APP=/usr/lib/mta-audio-editor-server
VENV=/opt/mta/server-venv
mkdir -p /etc/mta /var/lib/mta/projects /var/lib/mta/models /opt/mta
chmod 700 /etc/mta
# Refuse to replace a legacy git-managed install. Explicit migration is separate.
if [ -e /opt/mta/application/.git ] || [ -f /opt/mta/application/.mta-wizard-managed ]; then
  echo 'Legacy git-managed MTA installation detected: use explicit migration procedure.' >&2
  exit 1
fi
if [ ! -f /etc/mta/mta.env ]; then
  echo 'MTA_ADMIN_USERNAME=admin' > /etc/mta/mta.env
  ADMIN_PASSWORD=$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')
  printf 'MTA_ADMIN_PASSWORD=%s\n' "$ADMIN_PASSWORD" >> /etc/mta/mta.env
  printf 'MTA_DATA_DIR=/var/lib/mta/projects\n' >> /etc/mta/mta.env
fi
chmod 600 /etc/mta/mta.env
python3 "$APP/install_runtime.py" --python python3 --app "$APP" --wheels /usr/share/mta-audio-editor-server/wheelhouse --venv "$VENV"
systemctl daemon-reload || :
systemctl try-restart mta-server.service || :
systemctl try-restart mta-billing-scheduler.service || :
