[Unit]
Description=MTA AI Billing Scheduler (native package)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/usr/lib/mta-audio-editor-server
EnvironmentFile=/etc/mta/mta.env
ExecStart=/opt/mta/server-venv/bin/python -m app.ai_billing_scheduler
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/mta /etc/mta
